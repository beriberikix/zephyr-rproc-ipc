@@ -0,0 +1,36 @@
+# Copyright (c) 2024 Maurer Systems GmbH
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Binding for an OpenAMP RPMsg endpoint.
+
+  This node represents an RPMsg endpoint used for communication between
+  processors. It defines the local and remote endpoint addresses and
+  the service type associated with the endpoint.
+
+compatible: "openamp,rpmsg-endpoint"
+
+include: base.yaml
+
+on-bus: rpmsg
+
+properties:
+  reg:
+    required: true
+    description: |
+      Endpoint addresses in the form <src dst>, where:
+        - src: local endpoint address
+        - dst: remote endpoint address
+
+  type:
+    type: string
+    required: true
+    description: |
+      RPMsg service name associated with the endpoint.
+
+      Common values include:
+        - "rpmsg-tty"
+        - "rpmsg-raw"
+
+      These names may be used by the remote system (e.g. Linux)
+      to bind the appropriate RPMsg driver.
diff --git a/dts/bindings/remoteproc/openamp,rpmsg-virtio-device.yaml b/dts/bindings/remoteproc/openamp,rpmsg-virtio-device.yaml
new file mode 100644
index 000000000000..3cbd626725e0
--- /dev/null
+++ b/dts/bindings/remoteproc/openamp,rpmsg-virtio-device.yaml
@@ -0,0 +1,47 @@
+# Copyright (c) 2024 Maurer Systems GmbH
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Binding for an OpenAMP RPMsg VirtIO device.
+
+  This node represents a VirtIO device implementing the RPMsg protocol
+  over OpenAMP. It defines the shared memory used for RPMsg buffers and
+  configuration parameters for the associated worker thread.
+
+compatible: "openamp,rpmsg-virtio-device"
+
+include: openamp,virtio-device.yaml
+
+bus: rpmsg
+
+properties:
+  device-id:
+    default: 7
+    description: |
+      VirtIO device identifier. Defaults to 7 (VIRTIO_ID_RPMSG)
+      as defined by the VirtIO specification.
+
+  memory-region:
+    type: phandle
+    required: true
+    description: |
+      Phandle to the shared memory region used for RPMsg buffers.
+
+  zephyr,priority:
+    type: array
+    description: |
+      Workqueue thread priority for this RPMsg instance.
+
+      The value is an array consisting of:
+        - priority level
+        - priority type
+
+      The priority type must be one of:
+        - PRIO_COOP     (cooperative priority)
+        - PRIO_PREEMPT  (preemptive priority)
+
+      Examples:
+        K_PRIO_COOP(1)     -> <1 PRIO_COOP>
+        K_PRIO_PREEMPT(2)  -> <2 PRIO_PREEMPT>
+
+      If not specified, a default priority of <0 PRIO_PREEMPT> is used.
diff --git a/dts/bindings/remoteproc/openamp,virtio-device.yaml b/dts/bindings/remoteproc/openamp,virtio-device.yaml
new file mode 100644
index 000000000000..e2ec480f9bd3
--- /dev/null
+++ b/dts/bindings/remoteproc/openamp,virtio-device.yaml
@@ -0,0 +1,40 @@
+# Copyright (c) 2024 Maurer Systems GmbH
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Binding for a generic OpenAMP VirtIO device.
+
+  This node represents a VirtIO device backed by OpenAMP. It references
+  one or more vrings (virtqueues) used for communication between
+  processors.
+
+compatible: "openamp,virtio-device"
+
+include: base.yaml
+
+properties:
+  device-id:
+    type: int
+    description: |
+      VirtIO device identifier as defined by the VirtIO specification.
+
+  vrings:
+    type: phandle-array
+    required: true
+    description: |
+      Phandle array referencing the vring nodes associated with this
+      VirtIO device.
+
+  vring-names:
+    type: string-array
+    required: true
+    description: |
+      Names corresponding to each entry in the "vrings" property.
+      These names identify the role of each vring.
+
+  "#vring-cells":
+    type: int
+    const: 0
+    description: |
+      Number of cells in a vring specifier. Must be 0 since vrings
+      do not require additional specifier data.
diff --git a/dts/bindings/remoteproc/openamp,vring.yaml b/dts/bindings/remoteproc/openamp,vring.yaml
new file mode 100644
index 000000000000..cd00327442e0
--- /dev/null
+++ b/dts/bindings/remoteproc/openamp,vring.yaml
@@ -0,0 +1,41 @@
+# Copyright (c) 2024 Maurer Systems GmbH
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  Binding for an OpenAMP virtio vring.
+
+  A vring represents a virtqueue used for communication between processors.
+  It defines the shared memory region, notification mechanism, and buffer
+  configuration used by OpenAMP.
+
+compatible: "openamp,vring"
+
+include: base.yaml
+
+properties:
+  notify-id:
+    type: int
+    required: true
+    description: |
+      Identifier used for notifications (e.g. mailbox or interrupt ID)
+      associated with this vring.
+
+  device-address:
+    type: int
+    default: -1
+    description: |
+      Device address of the vring in the remote processor address space.
+      A value of -1 indicates that the address is assigned dynamically.
+
+  memory-region:
+    type: phandle
+    required: true
+    description: |
+      Phandle to the shared memory region used to store the vring
+      descriptors, available ring, and used ring.
+
+  num-buffers:
+    type: int
+    required: true
+    description: |
+      Number of buffers (descriptors) in the vring.
diff --git a/include/zephyr/drivers/remoteproc.h b/include/zephyr/drivers/remoteproc.h
new file mode 100644
index 000000000000..36962cbc032b
--- /dev/null
+++ b/include/zephyr/drivers/remoteproc.h
@@ -0,0 +1,96 @@
+/*
+ * Copyright (c) 2026 Simon Maurer <mail@maurer.systems>
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#ifndef ZEPHYR_INCLUDE_DRIVERS_REMOTEPROC_H_
+#define ZEPHYR_INCLUDE_DRIVERS_REMOTEPROC_H_
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#include <zephyr/device.h>
+#include <zephyr/devicetree.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Forward declarations for OpenAMP resource structures */
+struct fw_rsc_carveout;
+struct fw_rsc_vdev;
+
+#ifdef CONFIG_OPENAMP_RPMSG_VDEV
+struct rpmsg_device;
+#endif
+
+/**
+ * @brief Get pointer to the OpenAMP resource table
+ *
+ * Returns a pointer to the resource table included in the firmware image.
+ * The resource table describes shared memory regions, virtio devices,
+ * and other resources used for inter-processor communication.
+ *
+ * @param size Pointer to a variable that will be filled with the size
+ *             of the resource table in bytes.
+ *
+ * @return Pointer to the resource table, or NULL if not available.
+ */
+void *z_rproc_rsc_table(size_t *size);
+
+/**
+ * @brief Get carveout resource by name
+ *
+ * Searches the resource table for a carveout entry with the given name.
+ *
+ * @param name Null-terminated string identifying the carveout.
+ *
+ * @return Pointer to the carveout resource, or NULL if not found.
+ */
+struct fw_rsc_carveout *z_rproc_get_carveout_by_name(const char *name);
+
+/**
+ * @brief Get carveout resource by index
+ *
+ * Retrieves a carveout entry from the resource table by index.
+ *
+ * @param idx Index of the carveout entry.
+ *
+ * @return Pointer to the carveout resource, or NULL if the index
+ *         is out of range.
+ */
+struct fw_rsc_carveout *z_rproc_get_carveout_by_index(unsigned int idx);
+
+/**
+ * @brief Get VirtIO device resource
+ *
+ * Retrieves a VirtIO device entry from the resource table.
+ *
+ * @param idx Index of the VirtIO device entry.
+ *
+ * @return Pointer to the vdev resource, or NULL if the index
+ *         is out of range.
+ */
+struct fw_rsc_vdev *z_rproc_get_vdev(unsigned int idx);
+
+#ifdef CONFIG_OPENAMP_RPMSG_VDEV
+
+/**
+ * @brief Get RPMsg device associated with a RemoteProc instance
+ *
+ * Returns the RPMsg device corresponding to the given Zephyr device.
+ *
+ * @param dev Pointer to the Zephyr device instance.
+ *
+ * @return Pointer to the RPMsg device, or NULL if not available.
+ */
+struct rpmsg_device *z_rproc_get_rpmsg_device(const struct device *dev);
+
+#endif /* CONFIG_OPENAMP_RPMSG_VDEV */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ZEPHYR_INCLUDE_DRIVERS_REMOTEPROC_H_ */
